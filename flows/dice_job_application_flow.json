{
  "variables": {
    "package_name": "com.example.dicejobapp",
    "main_activity": "",
    "job_keyword": "Android Automation Engineer",
    "location": "Remote",
    "max_applications": 3,
    "search_wait_seconds": 3,
    "apply_wait_seconds": 2
  },
  "steps": [
    {
      "action": "wait",
      "timeout": 120
    },
    {
      "action": "launch",
      "package": "${package_name}",
      "activity": "${main_activity}"
    },
    {
      "action": "sleep",
      "seconds": 4
    },
    {
      "action": "tap_text_any",
      "texts": [
        "Skip",
        "Not now",
        "Maybe later",
        "Close"
      ],
      "contains": true,
      "optional": true
    },
    {
      "action": "tap_text_any",
      "texts": [
        "Search jobs",
        "Search",
        "Job title"
      ],
      "contains": true
    },
    {
      "action": "input",
      "text": "${job_keyword}"
    },
    {
      "action": "keyevent",
      "key": "ENTER"
    },
    {
      "action": "sleep",
      "seconds": "${search_wait_seconds}"
    },
    {
      "action": "tap_text_any",
      "texts": [
        "Location",
        "Where"
      ],
      "contains": true,
      "optional": true
    },
    {
      "action": "input",
      "text": "${location}"
    },
    {
      "action": "keyevent",
      "key": "ENTER"
    },
    {
      "action": "sleep",
      "seconds": "${search_wait_seconds}"
    },
    {
      "action": "repeat",
      "times": "${max_applications}",
      "steps": [
        {
          "action": "tap_text_any",
          "texts": [
            "Easy Apply",
            "Apply now",
            "Quick Apply",
            "Apply"
          ],
          "contains": true
        },
        {
          "action": "sleep",
          "seconds": "${apply_wait_seconds}"
        },
        {
          "action": "tap_text_any",
          "texts": [
            "Submit",
            "Send application",
            "Continue",
            "Review and submit"
          ],
          "contains": true,
          "optional": true
        },
        {
          "action": "sleep",
          "seconds": "${apply_wait_seconds}"
        },
        {
          "action": "screenshot",
          "output": "artifacts/dice_job_apply_${index}.png"
        },
        {
          "action": "keyevent",
          "key": "BACK"
        },
        {
          "action": "sleep",
          "seconds": 1
        },
        {
          "action": "swipe",
          "x1": 540,
          "y1": 1800,
          "x2": 540,
          "y2": 700,
          "duration_ms": 350
        }
      ]
    },
    {
      "action": "dump_ui",
      "output": "artifacts/dice_job_last_ui.xml"
    }
  ]
}
